# Copy this file to .env and fill in your values
# docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=containertrack
DB_USER=ctuser
DB_PASS=changeme_use_a_strong_password

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS=redis:6379

# ─── JWT (REQUIRED — min 32 chars) ───────────────────────────────────────────
JWT_KEY=CHANGE_ME_32_CHAR_RANDOM_SECRET_KEY!!
JWT_ISSUER=ContainerTrack
JWT_AUDIENCE=ContainerTrack

# ─── AIS Tracking (optional) ─────────────────────────────────────────────────
# Get a free API key at https://aisstream.io
AISSTREAM_KEY=

# ─── Observability (optional) ────────────────────────────────────────────────
SEQ_URL=http://seq:5341
# OTLP_ENDPOINT=http://otel-collector:4317

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Change to your public API URL in production
API_BASE_URL=http://localhost:5001
